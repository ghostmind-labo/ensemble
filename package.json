{
  "name": "@ghostmind-dev/ensemble",
  "version": "0.10.0",
  "description": "Multi-model agent ensembles. Describe a scene — nodes wired by edges, each node any model with scoped state — in one TypeScript file, and run it: conditions, loops, parallel groups, live visualization.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ensemble": "bin/ensemble.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "ui",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ensemble",
    "agents",
    "multi-agent",
    "multi-model",
    "orchestration",
    "graph",
    "openrouter",
    "llm",
    "cli",
    "mcp",
    "tool-calling"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "bench": "node bench/run.mts",
    "bench:optimize": "node bench/optimize.mts",
    "bench:test": "node bench/checker.test.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostmind-labo/ensemble.git"
  },
  "homepage": "https://github.com/ghostmind-labo/ensemble#readme",
  "bugs": {
    "url": "https://github.com/ghostmind-labo/ensemble/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
