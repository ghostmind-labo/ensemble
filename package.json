{
  "name": "@ghostmind-dev/ensemble",
  "version": "0.28.1",
  "description": "Typed decisions wired to your code. Asks Jev one calibrated question, calls models through OpenRouter when a node needs to write, draw or look, and emits the graph and the run as JSON.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ensemble": "bin/ensemble.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "jev",
    "typesafe",
    "classifier",
    "decision",
    "routing",
    "workflow",
    "graph",
    "confidence",
    "agent-skills",
    "mcp",
    "openrouter",
    "llm"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mts",
    "pretest": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostmind-labo/ensemble.git"
  },
  "homepage": "https://github.com/ghostmind-labo/ensemble#readme",
  "bugs": {
    "url": "https://github.com/ghostmind-labo/ensemble/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
