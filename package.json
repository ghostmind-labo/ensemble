{
  "name": "@ghostmind-dev/ensemble",
  "version": "0.1.0",
  "description": "Multi-model agent ensembles. Describe a scene \u2014 nodes wired by edges, each node any model with scoped state \u2014 in one TypeScript file, and run it: conditions, loops, parallel groups, live visualization.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ensemble": "./bin/ensemble.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "ui",
    "scenes",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ensemble",
    "agents",
    "multi-agent",
    "multi-model",
    "orchestration",
    "graph",
    "opencode",
    "openrouter",
    "llm",
    "cli"
  ],
  "scripts": {
    "graph": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.15",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "opencode-ai": ">=1.18.0"
  },
  "peerDependenciesMeta": {
    "opencode-ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostmind-labo/ensemble.git"
  },
  "homepage": "https://github.com/ghostmind-labo/ensemble#readme",
  "bugs": {
    "url": "https://github.com/ghostmind-labo/ensemble/issues"
  }
}
