---
import "../styles/site.css";
import { GITHUB, NPM } from "../lib/docs";

interface Props {
  title: string;
  description?: string;
  active?: "home" | "docs";
}
const { title, description = "One calibrated decision, wired to your code.", active } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="top">
      <div class="bar">
        <a class="brand" href="/">ensem<span>ble</span></a>
        <nav>
          <a href="/docs" class={active === "docs" ? "on" : ""}>Docs</a>
          <a href="/docs/api">API</a>
          <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
          <a href={NPM} target="_blank" rel="noopener">npm</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="foot">
      <div class="bar">
        <span>@ghostmind-dev/ensemble · MIT</span>
        <a href="/docs">Docs</a>
        <a href={GITHUB} target="_blank" rel="noopener">Source</a>
      </div>
    </footer>
  </body>
</html>
