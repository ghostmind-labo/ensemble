---
import Docs from "../../layouts/Docs.astro";
import { GROUPS, PAGES } from "../../lib/docs";
---
<Docs title="Docs">
  <h1>Docs</h1>
  <p>
    Everything here is the repo's own markdown — the README and the references the Claude Code plugin
    teaches from — so the docs and the code are never out of step.
  </p>
  {GROUPS.map((group) => (
    <>
      <h2>{group}</h2>
      <div class="cards" style="margin: 16px 0; padding: 0">
        {PAGES.filter((page) => page.group === group).map((page) => (
          <a class="card" href={`/docs/${page.slug}`}>
            <h3>{page.title}</h3>
            <p>{page.blurb}</p>
          </a>
        ))}
      </div>
    </>
  ))}
</Docs>
