# ensemble / web: the site and its docs (Astro). No secrets: it only renders the
# repo's own markdown. Committed.
# @currentEnv=$APP_ENV
# @defaultRequired=true
# @defaultSensitive=false
# ---
# @type=enum(dev, prod)
APP_ENV=dev
# @type=port
PORT=3060
# @type=url
PUBLIC_URL=https://ensemble.ghostmind.app
# Where the repo (README.md, docs/, plugin/skills/) sits inside the container: bind-mounted
# read-only in dev, copied into the image in prod. The docs are rendered from it.
DOCS_ROOT=/usr/app/repo
